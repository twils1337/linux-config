        else:
            ctx.sh('"$HOME/.cargo/bin/rustup" self uninstall -y || rm -rf "$HOME/.cargo" "$HOME/.rustup"', check=False)
            ctx.rc.remove("rust")
        ctx.state.drop(self.id)


