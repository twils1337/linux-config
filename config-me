class AptEngine(Item):
    """Container engines installed from apt; versions come from `apt-cache madison`."""
    example = "27.3"
    section = "containers"
    has_lts = False
    packages: Tuple[str, ...] = ()
    main_pkg = ""

    def latest(self) -> str:
        return "latest"

    def version_hint(self) -> str:
        return "no LTS: Enter installs the newest packaged version"

    def apt_spec(self, ctx: Ctx, spec: str) -> str:
        """`pkg` for latest, or `pkg=<full apt version>` for a requested version."""
        if spec in ("lts", "latest"):
            return ""
        cands = ctx.apt.candidates(self.main_pkg)
        for c in cands:
            bare = c.split(":", 1)[-1]
            if bare.startswith(spec) or c.startswith(spec):
                return c
        if ctx.dry_run:
            return spec
        raise CommandError(f"{self.main_pkg} {spec} isn't available (try: apt-cache madison {self.main_pkg})")

    def detect_cmd(self) -> str:
        raise NotImplementedError

    def detect(self, ctx: Ctx) -> Optional[Detected]:
        out = ctx.probe(self.detect_cmd())
        if not out:
            return None
        return Detected(first_version(out) or "?", self.method_of(ctx, "apt"), ctx.probe(f"command -v {self.id}") or "")

    def post_install(self, ctx: Ctx) -> None:
        pass

    def start_service(self, ctx: Ctx, svc: str) -> None:
        if has_systemd():
            ctx.sh(f"systemctl enable --now {svc}", sudo=True, check=False)
        else:
            ctx.sh(f"service {svc} start || true", sudo=True, check=False)
            if is_wsl():
                ctx.ui.warn("WSL without systemd: start it with `sudo service " + svc + " start`, or enable systemd "
                            "in /etc/wsl.conf ([boot] systemd=true) and run `wsl --shutdown`")

    def install(self, ctx: Ctx, spec: str, method: str) -> str:
        pinned = self.apt_spec(ctx, spec)
        pkgs = [f"{p}={pinned}" if pinned and p == self.main_pkg else p for p in self.packages]
        self.add_repo(ctx)
        ctx.apt.install(*pkgs)
        self.post_install(ctx)
        version = ctx.apt.version(self.main_pkg) or spec
        ctx.state.set(self.id, method="apt", version=version)
        return version

    def add_repo(self, ctx: Ctx) -> None:
        pass


