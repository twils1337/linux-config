def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="config-me",
        description="Configure a fresh Ubuntu VM / WSL distro: languages, a container engine and AI CLI tools.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        allow_abbrev=False,
        epilog="""sections for -rm: lang, containers (alias: images), ai, or tool ids:
  node dotnet java go python rust docker podman containerd claude codex copilot gemini

examples:
  config-me                 interactive setup
  config-me -y              accept every default (all languages LTS, Docker, all AI CLIs)
  config-me -blang          just the LTS of every language, no questions
  config-me -stat           what's installed, by section
  config-me -rm ai          uninstall every AI CLI
  config-me -rm             uninstall everything config-me manages
  config-me -mute -blang    progress bar instead of logs
""",
    )
    p.add_argument("-y", "--yes", action="store_true", help="agree to everything (use every default, no questions)")
    p.add_argument("-blang", "--blang", action="store_true",
                   help="install the latest LTS of every language (latest where there's no LTS), nothing else")
    p.add_argument("-rm", "--rm", nargs="*", metavar="SECTION", default=None,
                   help="uninstall everything config-me manages, or only the given sections/tools")
    p.add_argument("-stat", "--stat", action="store_true", help="list managed software by section with installed versions")
    p.add_argument("-mute", "--mute", action="store_true", help="no logs; show a progress bar (full log goes to the log file)")
    p.add_argument("--dry-run", action="store_true", help="print what would run without changing anything")
    p.add_argument("--version", action="version", version=f"config-me {VERSION}")
    return p


def check_platform(ui: UI) -> None:
    if sys.platform != "linux" or not shutil.which("apt-get"):
        raise SystemExit("config-me: this script targets Ubuntu (Linux with apt)")
    if os.geteuid() == 0 and os.environ.get("SUDO_USER"):
        ui.warn(f"running under sudo: user-level tools would go to {HOME}, not ~{os.environ['SUDO_USER']}. "
                "Run config-me as your normal user; it calls sudo itself when needed.")


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    ui = UI(mute=args.mute)
    ui.open_log()
    check_platform(ui)
    run = Runner(ui, dry_run=args.dry_run)
    ctx = Ctx(ui=ui, run=run, apt=Apt(run), rc=ShellRc(ui, args.dry_run), state=State(args.dry_run), dry_run=args.dry_run)
    prompt = Prompt(ui, assume_yes=args.yes, automatic=args.blang)
    if args.dry_run:
        ui.say(ui.yellow("dry run: nothing will be changed"))
    try:
        if args.stat:
            return cmd_stat(ctx)
        if args.rm is not None:
            return cmd_rm(ctx, prompt, args.rm)
        if args.blang:
            plan = blang_plan(ctx)
        else:
            ui.say(ui.bold("config-me") + ui.dim(f" {VERSION}: set up this {'WSL distro' if is_wsl() else 'machine'}"))
            plan = interactive_plan(prompt, ctx, args.yes)
        if not plan.actions:
            ui.say("\nNothing selected. Bye!")
            return 0
        ui.say()
        ui.say(ui.bold("Plan:"))
        for a in plan.actions:
            ui.say(f"  - {a.label()}")
        if not prompt.confirm("Go ahead?", default=True):
            ui.say("Aborted.")
            return 1
        return execute(ctx, plan)
    except KeyboardInterrupt:
        ui.end_bar()
        ui.say(ui.yellow("\ninterrupted"))
        return 130


if __name__ == "__main__":
    sys.exit(main())
