        out = ctx.probe("rustc --version")
        if not out:
            return None
        path = ctx.probe("command -v rustc") or ""
        method = self.method_of(ctx, "")
        if not method:
            method = ("rustup" if ".cargo" in path or ".rustup" in path else "mise" if "mise" in path else
                      "apt" if ctx.apt.installed("rustc") else "unknown")
        return Detected(first_version(out) or "?", method, path)

