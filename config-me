        toolchain = "stable" if spec in ("lts", "latest") else spec.lstrip("vV")
        ctx.apt.install("build-essential", "curl", "ca-certificates", "pkg-config")
        if method == "mise":
            mise_use(ctx, "rust", toolchain)
