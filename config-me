class Prompt:
    """User input.

    * `assume_yes` (-y): yes/no confirmations ("Go ahead?", "Proceed?") are answered "yes".
      Your choices (what to install, which version, which manager) are still asked.
    * `automatic` (-blang): nothing is asked at all; every question takes its default.
    """

    def __init__(self, ui: UI, assume_yes: bool = False, automatic: bool = False):
        self.ui = ui
        self.yes = assume_yes or automatic
        self.auto = automatic
        self.interactive = sys.stdin.isatty() and sys.stdout.isatty()

    def line(self, text: str, default: str = "") -> str:
        if self.auto:
            self.ui.say(f"{text}{self.ui.dim(default or '<Enter>')}  (automatic)")
            return default
        try:
            ans = input(text)
        except EOFError:
            ans = ""
        return ans.strip() or default

    def confirm(self, text: str, default: bool = True) -> bool:
        hint = "[Y/n]" if default else "[y/N]"
        if self.yes:
            self.ui.say(f"{text} {hint} {self.ui.dim('y')}  (-y)")
            return True
        ans = self.line(f"{text} {hint} ", "y" if default else "n").lower()
        return ans in ("y", "yes")

    def checklist(self, title: str, options: List[Tuple[str, str]], defaults: Sequence[str] = (),
                  radio: bool = False, default_if_yes: Sequence[str] = ()) -> List[str]:
        """Multi-select (or single-select when radio=True). Returns selected keys."""
        if self.auto:
            chosen = list(default_if_yes)
            labels = ", ".join(lbl for k, lbl in options if k in chosen) or "none"
            self.ui.say(f"{self.ui.bold(title)}: {labels}  (automatic)")
            return chosen
        if self.interactive:
            try:
                return self._checklist_tty(title, options, list(defaults), radio)
            except (OSError, ImportError):
                pass
        return self._checklist_plain(title, options, list(defaults), radio)

    def _checklist_plain(self, title: str, options: List[Tuple[str, str]], selected: List[str], radio: bool) -> List[str]:
        self.ui.say(self.ui.bold(title))
        for n, (_k, lbl) in enumerate(options, 1):
            self.ui.say(f"  {n}) {lbl}")
        kind = "one number" if radio else "numbers separated by spaces/commas, 'all'"
        ans = self.line(f"Choose {kind} (Enter = {'skip' if not selected else 'defaults'}): ", "")
        if not ans:
            return selected[:1] if radio else selected
        if ans.lower() == "all" and not radio:
            return [k for k, _ in options]
        picks = []
        for tok in re.split(r"[,\s]+", ans):
            if tok.isdigit() and 1 <= int(tok) <= len(options):
                picks.append(options[int(tok) - 1][0])
        return picks[:1] if radio else list(dict.fromkeys(picks))

    def _checklist_tty(self, title: str, options: List[Tuple[str, str]], selected: List[str], radio: bool) -> List[str]:
        import termios
        import tty

        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        chosen = set(selected[:1] if radio else selected)
        cursor = 0
        help_text = ("↑/↓ move · space select (one) · Enter confirm · Enter on nothing = skip" if radio else
                     "↑/↓ move · space toggle · a all/none · Enter confirm")
        mark_on, mark_off = ("(•)", "( )") if radio else ("[x]", "[ ]")
        lines_drawn = 0

        def draw() -> None:
            nonlocal lines_drawn
            out = []
            if lines_drawn:
                out.append(f"\033[{lines_drawn}F")
            out.append(f"\033[J{self.ui.bold(title)}  {self.ui.dim(help_text)}\r\n")
            for i, (k, lbl) in enumerate(options):
                arrow = self.ui.cyan("›") if i == cursor else " "
                mark = self.ui.green(mark_on) if k in chosen else mark_off
                out.append(f" {arrow} {mark} {lbl}\r\n")
            sys.stdout.write("".join(out))
            sys.stdout.flush()
            lines_drawn = len(options) + 1

        def read_key() -> str:
            ch = os.read(fd, 1)
            if ch == b"\x1b":
                seq = os.read(fd, 2)
                return {b"[A": "up", b"[B": "down"}.get(seq, "")
            return {b" ": "space", b"\r": "enter", b"\n": "enter", b"\x03": "ctrl-c", b"k": "up", b"j": "down",
                    b"a": "all", b"x": "space", b"q": "ctrl-c"}.get(ch, ch.decode(errors="ignore"))

        try:
            tty.setraw(fd)
            sys.stdout.write("\033[?25l")
            draw()
            while True:
                key = read_key()
                if key == "up":
                    cursor = (cursor - 1) % len(options)
                elif key == "down":
                    cursor = (cursor + 1) % len(options)
                elif key == "space":
                    k = options[cursor][0]
                    if radio:
                        chosen = set() if k in chosen else {k}
                    else:
                        chosen.symmetric_difference_update({k})
                elif key == "all" and not radio:
                    chosen = set() if len(chosen) == len(options) else {k for k, _ in options}
                elif key.isdigit() and 1 <= int(key) <= len(options):
                    cursor = int(key) - 1
                    k = options[cursor][0]
                    if radio:
                        chosen = set() if k in chosen else {k}
                    else:
                        chosen.symmetric_difference_update({k})
                elif key == "enter":
                    break
                elif key == "ctrl-c":
                    raise KeyboardInterrupt
                draw()
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
            sys.stdout.write("\033[?25h")
            sys.stdout.flush()
        result = [k for k, _ in options if k in chosen]
        self.ui.to_file(f"{title}: {result}")
        return result


