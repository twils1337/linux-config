class Go(Item):
    example = "1.24 or 1.24.3"
    id, name, section = "go", "Go", "lang"
    default_method = "official"
    managers = [("mise", "mise (polyglot)")]
    has_lts = False
    DL = "https://go.dev/dl/?mode=json"

    def latest(self) -> str:
        return strip_prefix(http_json(self.DL)[0]["version"], "go")  # type: ignore[index]

    def resolve_specific(self, spec: str, method: str) -> str:
        rel = http_json(self.DL + "&include=all")
        versions = [strip_prefix(r["version"], "go") for r in rel if r.get("stable")]  # type: ignore[union-attr]
        v = pick_version(versions, strip_prefix(spec, "go"))
        if not v:
            raise ValueError(f"no Go release matches {spec!r}")
        return v

    def detect(self, ctx: Ctx) -> Optional[Detected]:
        out = ctx.probe("go version")
        problem = ""
        if not out:
            # A stale GOROOT (e.g. left behind by goenv) breaks every go command; look past it.
            goroot = os.environ.get("GOROOT", "")
            out = ctx.probe("env -u GOROOT go version") if goroot else None
            if not out:
                return None
            problem = (f"GOROOT is set to {goroot}, which {'does not exist' if not Path(goroot).is_dir() else 'is not this Go'}, "
                       "so `go` fails in your shell. Find where it's set with `bash -lixc exit 2>&1 | grep -n GOROOT`, "
                       "remove that line, then `unset GOROOT` (or open a new terminal).")
        m = re.search(r"go(\d+\.\d+(?:\.\d+)?)", out)
        path = ctx.probe("command -v go") or ""
        method = self.method_of(ctx, "")
        if not method:
            method = ("official" if path.startswith("/usr/local/go") else "mise" if "mise" in path else
                      "apt" if ctx.apt.installed("golang-go") else "unknown")
        return Detected(m.group(1) if m else "?", method, path, problem=problem)

    def install(self, ctx: Ctx, spec: str, method: str) -> str:
        if method == "mise":
            mise_use(ctx, "go", "latest" if spec in ("lts", "latest") else spec)
            version = mise_has(ctx, "go") or spec
        else:
            version = self.resolve(ctx, spec, method)
            garch, _ = arch()
            ctx.apt.install("curl", "ca-certificates")
            ctx.sh(f"rm -rf /usr/local/go && curl -4 -fsSL --retry 3 --retry-delay 2 https://go.dev/dl/go{version}.linux-{garch}.tar.gz | tar -xz -C /usr/local",
                   sudo=True)
            ctx.rc.add("go", 'export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"')
            method = "official"
            goroot = os.environ.get("GOROOT", "")
            if goroot and goroot != "/usr/local/go":
                ctx.ui.warn(f"your shell sets GOROOT={goroot}; `go` will fail until you remove it. Find where with "
                            "`bash -lixc exit 2>&1 | grep -n GOROOT`. The official build needs no GOROOT.")
        ctx.state.set(self.id, method=method, version=version)
        return version

    def uninstall(self, ctx: Ctx, det: Detected) -> None:
        if det.method == "mise":
            mise_remove(ctx, "go")
        elif det.method == "apt":
            ctx.apt.purge("golang-go", "golang")
        else:
            ctx.sh("rm -rf /usr/local/go", sudo=True)
            ctx.rc.remove("go")
        ctx.state.drop(self.id)


