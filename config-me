            if not (HOME / ".cargo" / "bin" / "rustup").exists():
                ctx.sh(f"curl -4 --proto '=https' --tlsv1.2 -sSf --retry 3 --retry-delay 2 https://sh.rustup.rs | sh -s -- -y --no-modify-path "
                       f"--default-toolchain {q(toolchain)} --profile default")
            else:
                ctx.sh(f'"$HOME/.cargo/bin/rustup" update {q(toolchain)} || "$HOME/.cargo/bin/rustup" toolchain install {q(toolchain)}')
                ctx.sh(f'"$HOME/.cargo/bin/rustup" default {q(toolchain)}')
