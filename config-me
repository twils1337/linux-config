@dataclass
class Action:
    item: Item
    kind: str                # "install" | "update" | "remove"
    spec: str = ""           # "lts" | "latest" | explicit version
    method: str = ""         # install method / version manager
    detected: Optional[Detected] = None

    def label(self) -> str:
        if self.kind == "remove":
            return f"remove {self.item.name}"
        how = "" if self.method == self.item.default_method else f" via {self.method}"
        what = {"lts": "LTS" if self.item.has_lts else "latest", "latest": "latest"}.get(self.spec, self.spec)
        return f"{self.kind} {self.item.name} {what}{how}"


@dataclass
class Plan:
    actions: List[Action] = field(default_factory=list)


VERSION_RE = re.compile(r"^[vV]?\d+(\.\d+){0,3}([-+][0-9A-Za-z.]+)?$")


def parse_version_answer(ans: str) -> Optional[str]:
    """'' / y / Y → 'lts'; 'latest' → 'latest'; n → None (skip); anything else → that version."""
    a = ans.strip()
    if a.lower() in ("", "y", "yes", "lts"):
        return "lts"
    if a.lower() in ("n", "no", "skip"):
        return None
    if a.lower() in ("latest", "l"):
        return "latest"
    return a


# Extra lookups that installers make later; warming them now keeps execution snappy too.
PREFETCH_URLS = (
    "https://api.github.com/repos/nvm-sh/nvm/releases/latest",
    "https://api.github.com/repos/containerd/nerdctl/releases/latest",
)


def prefetch(ctx: Ctx, items: Sequence[Item], hints: bool = True) -> None:
    """Check what's installed and look up available versions for every item, in parallel,
    before any question is asked. Shows one progress line while it works."""
    ui = ctx.ui
    jobs: List[Tuple[str, Callable[[], object]]] = [(f"detect:{i.id}", lambda i=i: ctx.detect(i)) for i in items]
    if hints:
        jobs += [(f"hint:{i.id}", lambda i=i: ctx.hint(i)) for i in items]
        jobs += [(f"url:{u}", lambda u=u: http_json(u)) for u in PREFETCH_URLS]
    what = "checking what's installed and looking up the latest versions online" if hints else "checking what's installed"
    total, done = len(jobs), 0
    started = time.time()

    def show(final: bool = False) -> None:
        text = f"  {what}… {done}/{total}" + (f" ({time.time() - started:.0f}s)" if final else "")
        if ui.tty:
            sys.stdout.write("\r\033[K" + ui.dim(text) + ("\n" if final else ""))
            sys.stdout.flush()
        elif final:
            print(text, flush=True)

    if not ui.tty:
        print(f"  {what}…", flush=True)
    show()
    with concurrent.futures.ThreadPoolExecutor(max_workers=12) as pool:
        futures = {pool.submit(fn): name for name, fn in jobs}
        for fut in concurrent.futures.as_completed(futures):
            try:
                fut.result()
            except Exception as e:  # noqa: BLE001 - a failed lookup only means no hint
                ui.to_file(f"  prefetch {futures[fut]} failed: {e}")
            done += 1
            show()
    show(final=True)
    if hints:
        missing = [i.name for i in items if not ctx.hints.get(i.id)]
        if missing and len(missing) == len(items):
            ui.say(ui.yellow("  couldn't reach the version servers (offline?); you can still type versions, "
                             "and lookups will be retried when installing"))


def ask_item(prompt: Prompt, ctx: Ctx, item: Item, ask_manager: bool) -> Optional[Action]:
    ui = ctx.ui
    ui.say()
    ui.say(ui.bold(f"── {item.name} ") + ui.dim("─" * max(2, 40 - len(item.name))))
    det = ctx.detect(item)
    kind = "install"
    if det:
        where = f" ({det.method}{', ' + det.path if det.path else ''})"
        ui.say(f"  installed: {ui.green(det.version)}{ui.dim(where)}")
        if det.problem:
            ui.say(ui.yellow(f"  ! {det.problem}"))
        if not det.managed:
            ui.say(ui.dim("  this is the OS's own copy; config-me can install another version alongside it"))
        if det.managed:
            question = f"  {item.name} is already installed. Update, remove, or keep it? [U/r/k] (Enter = update): "
            valid = ("u", "update", "y", "r", "remove", "k", "keep", "n")
        else:
            question = f"  Install another {item.name} alongside it, or keep just this one? [U/k] (Enter = install): "
            valid = ("u", "update", "y", "k", "keep", "n")
        while True:
            ans = prompt.line(question, "u").lower()
            if ans in valid:
                break
            ui.say(ui.yellow("  answer u (update), " + ("r (remove), " if det.managed else "") + "or k (keep)"))
        if ans in ("k", "keep", "n"):
            return None
        if ans in ("r", "remove"):
            return Action(item, "remove", detected=det)
        kind = "update"
    hint = "" if prompt.auto else ctx.hint(item)
    if hint:
        ui.say(ui.dim(f"  available: {hint}"))
    lts_word = "latest LTS" if item.has_lts else "latest"
    ui.say(f"  Enter or y = {lts_word} · 'latest' = newest release · or type a version (e.g. {item.example}) · n = skip")
    while True:
        ans = prompt.line(f"  Which version of {item.name} do you want? ", "y")
        spec = parse_version_answer(ans)
        if spec is None:
            return None
        if spec in ("lts", "latest") or VERSION_RE.match(spec):
            break
        ui.say(ui.yellow(f"  {ans!r} doesn't look like a version (e.g. 22, 3.12, 1.24.3, 21.0.5-tem)"))
    method = item.default_method
    if ask_manager and item.managers:
        names = " / ".join(k for k, _ in item.managers)
        for k, desc in item.managers:
            ui.say(ui.dim(f"    {k:<6} {desc}"))
        default_desc = {"official": "official release build", "dotnet-install": "Microsoft's dotnet-install script",
                        "temurin-apt": "Adoptium Temurin apt repo", "deadsnakes": "deadsnakes apt packages",
                        "rustup": "rustup"}.get(item.default_method, item.default_method)
        while True:
            ans = prompt.line(f"  Install {item.name} with a version manager? [{names}] (Enter or n = no, use {default_desc}): ",
                              "n").lower()
            if ans in ("", "n", "no", "none"):
                break
            if ans in {k for k, _ in item.managers}:
                method = ans
                break
            ui.say(ui.yellow(f"  pick one of: {names}, or n"))
    return Action(item, kind, spec, method, det)


def interactive_plan(prompt: Prompt, ctx: Ctx, assume_yes: bool) -> Plan:
    plan = Plan()
    ui = ctx.ui
    prefetch(ctx, list(ITEMS.values()))
    ui.say()

    # 1. Languages
    langs = items_in("lang")
    picked = prompt.checklist("1) Programming languages", [(i.id, i.name) for i in langs],
                              defaults=(), default_if_yes=[i.id for i in langs])
    for item_id in picked:
        act = ask_item(prompt, ctx, ITEMS[item_id], ask_manager=True)
        if act:
            plan.actions.append(act)

    # 2. Container engine (one at most)
    engines = items_in("containers")
    ui.say()
    picked = prompt.checklist("2) Container engine (pick one, or none)", [(i.id, i.name) for i in engines],
                              radio=True, default_if_yes=["docker"])
    if picked:
        others = [e for e in engines if e.id != picked[0] and ctx.detect(e)]
        if others:
            ui.say(ui.yellow(f"  note: {', '.join(e.name for e in others)} is also installed; "
                             f"remove it with `config-me -rm {others[0].id}` if they conflict"))
        act = ask_item(prompt, ctx, ITEMS[picked[0]], ask_manager=False)
        if act:
            plan.actions.append(act)

    # 3. AI CLIs
    ais = items_in("ai")
    ui.say()
    picked = prompt.checklist("3) AI CLI tools", [(i.id, i.name) for i in ais], default_if_yes=[i.id for i in ais])
    for item_id in picked:
        act = ask_item(prompt, ctx, ITEMS[item_id], ask_manager=False)
        if act:
            plan.actions.append(act)
    return plan


def blang_plan(ctx: Ctx) -> Plan:
    plan = Plan()
    for item in items_in("lang"):
        det = ctx.detect(item)
        plan.actions.append(Action(item, "update" if det else "install", "lts", item.default_method, det))
    return plan


def resolve_targets(names: Sequence[str]) -> List[Item]:
    if not names or any(n.lower() in ("all", "everything") for n in names):
        return list(ITEMS.values())
    out: List[Item] = []
    for n in names:
        key = n.lower().strip()
        if key in SECTION_ALIASES:
            out += items_in(SECTION_ALIASES[key])
        elif key in ITEMS:
            out.append(ITEMS[key])
        elif key in ("c#", "csharp", "net", ".net"):
            out.append(ITEMS["dotnet"])
        else:
            valid = ", ".join(sorted(set(SECTION_ALIASES) | set(ITEMS)))
            raise SystemExit(f"config-me: unknown section or tool {n!r} (valid: {valid})")
    return list(dict.fromkeys(out))


# =============================================================================
# Execution
# =============================================================================

def execute(ctx: Ctx, plan: Plan) -> int:
    ui = ctx.ui
    if not plan.actions:
        ui.say("Nothing to do.")
        return 0
    total = len(plan.actions)
    failures: List[Tuple[Action, str]] = []
    results: List[str] = []
    started = time.time()
    if not ctx.run.is_root and not ctx.dry_run:
        ctx.run.ensure_sudo()
    ui.bar(0, total, "starting…")
    for n, act in enumerate(plan.actions, 1):
        ui.bar(n - 1, total, act.label())
        ui.step(f"[{n}/{total}] {act.label()}")
        try:
            if act.kind == "remove":
                det = act.detected or act.item.detect(ctx)
                if det:
                    act.item.uninstall(ctx, det)
                results.append(f"{ui.green('✓')} removed {act.item.name}")
            else:
                if act.kind == "update" and act.detected and act.detected.managed and act.detected.method not in (
                        act.method, "unknown", "system") and act.item.section == "lang":
                    ui.warn(f"{act.item.name} is currently installed via {act.detected.method}; installing via "
                            f"{act.method} too. Whichever comes first on PATH wins (remove the old one with -rm).")
                version = act.item.install(ctx, act.spec, act.method)
                results.append(f"{ui.green('✓')} {act.item.name} {version} ({act.method or 'default'})")
                ui.ok(f"{act.item.name} {version}")
        except Exception as e:  # noqa: BLE001 - one failed item must not stop the rest
            msg = (str(e) or type(e).__name__).splitlines()[0]
            failures.append((act, str(e)))
            results.append(f"{ui.red('✗')} {act.label()}: {msg}")
            ui.error(str(e))
        except KeyboardInterrupt:
            ui.end_bar()
            ui.say(ui.yellow("\ninterrupted"))
            return 130
        ui.bar(n, total, act.label())
    ui.end_bar()
    ui.say()
    ui.say(ui.bold(f"Summary ({time.time() - started:.0f}s)"))
    for r in results:
        ui.say("  " + r)
    if not ctx.dry_run:
        ui.say(ui.dim(f"  full log: {LOG_FILE}"))
        if any(a.kind != "remove" for a in plan.actions):
            ui.say(ui.dim("  open a new terminal (or `exec $SHELL -l`) so PATH changes take effect"))
    return 1 if failures else 0


def cmd_stat(ctx: Ctx) -> int:
    ui = ctx.ui
    ui.say(ui.bold(f"config-me {VERSION}") + ui.dim(f"  (state: {STATE_FILE})"))
    prefetch(ctx, list(ITEMS.values()), hints=False)
    for sec, title in SECTIONS.items():
        ui.say()
        ui.say(ui.bold(title))
        for item in items_in(sec):
            det = ctx.detect(item)
            if det:
                extra = det.method + ("" if det.managed else ", not managed")
                mark = ui.yellow("●") if det.problem else ui.green("●")
                ui.say(f"  {mark} {item.name:<36} {det.version:<22} {ui.dim(extra)}")
                if det.problem:
                    ui.say(ui.yellow(f"      ! {det.problem}"))
            else:
                ui.say(f"  {ui.dim('○')} {item.name:<36} {ui.dim('not installed')}")
    ui.say()
    ui.say(ui.bold("Version managers"))
    for name, check in (("mise", f"{mise_bin()} --version"), ("nvm", '. "$HOME/.nvm/nvm.sh" && nvm --version'),
                        ("fnm", '"$HOME/.local/share/fnm/fnm" --version'), ("SDKMAN!", '. "$HOME/.sdkman/bin/sdkman-init.sh" && sdk version'),
                        ("pyenv", '"$HOME/.pyenv/bin/pyenv" --version'), ("uv", f'"{LOCAL_BIN}/uv" --version'),
                        ("rustup", '"$HOME/.cargo/bin/rustup" --version 2>/dev/null')):
        v = first_version(ctx.probe(check))
        ui.say(f"  {ui.green('●') if v else ui.dim('○')} {name:<36} {v or ui.dim('not installed')}")
    return 0


def cmd_rm(ctx: Ctx, prompt: Prompt, names: Sequence[str]) -> int:
    ui = ctx.ui
    targets = resolve_targets(names)
    prefetch(ctx, targets, hints=False)
    found = [(i, d) for i in targets for d in [ctx.detect(i)] if d]
    removable = [(i, d) for i, d in found if d.managed]
    for i, d in found:
        if not d.managed:
            ui.say(ui.dim(f"skipping {i.name} {d.version}: it's the OS's own copy"))
    if not removable:
        ui.say("Nothing installed to remove.")
        return 0
    ui.say(ui.bold("Will uninstall:"))
    for i, d in removable:
        ui.say(f"  - {i.name} {d.version} ({d.method})")
    if not prompt.confirm("Proceed?", default=False):
        ui.say("Aborted.")
        return 1
    plan = Plan([Action(i, "remove", detected=d) for i, d in removable])
    code = execute(ctx, plan)
    full = not names or any(n.lower() in ("all", "everything") for n in names)
    if full and ctx.state.get("_mise") and not ctx.dry_run:
        ctx.sh(f"{mise_bin()} implode --yes || rm -f {MISE}", check=False)
        ctx.rc.remove("mise")
        ctx.state.drop("_mise")
    if full:
        ctx.rc.remove("local-bin")
    return code


