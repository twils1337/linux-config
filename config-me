class Python(Item):
    example = "3.12"
    id, name, section = "python", "Python", "lang"
    default_method = "deadsnakes"
    managers = [("uv", "uv (Astral; fast, manages Pythons + venvs)"), ("pyenv", "pyenv (builds from source)"),
                ("mise", "mise (polyglot)")]
    has_lts = False
    EOL = "https://endoflife.date/api/python.json"
    PYENV_DEPS = ("build-essential", "libssl-dev", "zlib1g-dev", "libbz2-dev", "libreadline-dev", "libsqlite3-dev",
                  "curl", "git", "libncursesw5-dev", "xz-utils", "tk-dev", "libxml2-dev", "libxmlsec1-dev",
                  "libffi-dev", "liblzma-dev")

    def _cycles(self) -> list:
        return http_json(self.EOL)  # type: ignore[return-value]

    def latest(self) -> str:
        return max((c["latest"] for c in self._cycles()), key=vkey)

    def resolve_specific(self, spec: str, method: str) -> str:
        spec = spec.strip()
        if spec.count(".") >= 2:
            return spec
        for c in self._cycles():
            if c["cycle"] == spec:
                return c["latest"]
        raise ValueError(f"no Python release matches {spec!r}")

    def detect(self, ctx: Ctx) -> Optional[Detected]:
        st = ctx.state.get(self.id)
        if st:
            m = st["method"]
            if m == "deadsnakes":
                minor = ".".join(st["version"].split(".")[:2])
                out = ctx.probe(f"python{minor} --version")
                if out:
                    return Detected(first_version(out) or st["version"], m, f"/usr/bin/python{minor}")
            elif m == "uv":
                out = ctx.probe(f'"$({LOCAL_BIN}/uv python find --managed-python 2>/dev/null)" --version')
                if out:
                    return Detected(first_version(out) or st["version"], m)
            elif m == "pyenv":
                out = ctx.probe('"$HOME/.pyenv/bin/pyenv" global')
                if out:
                    return Detected(out.split()[0], m, str(HOME / ".pyenv"))
            elif m == "mise":
                v = mise_has(ctx, "python")
                if v:
                    return Detected(v, m)
        out = ctx.probe("python3 --version")
        if out:
            path = ctx.probe("command -v python3") or ""
            if path.startswith("/usr/bin"):
                return Detected(first_version(out) or "?", "system", path, managed=False)
            method = "pyenv" if ".pyenv" in path else "mise" if "mise" in path else "uv" if "uv" in path else "unknown"
            return Detected(first_version(out) or "?", method, path)
        return None

    def install(self, ctx: Ctx, spec: str, method: str) -> str:
        if method == "uv":
            if not (LOCAL_BIN / "uv").exists():
                ctx.apt.install("curl", "ca-certificates")
                ctx.sh("curl -4 -LsSf --retry 3 --retry-delay 2 https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh")
                ensure_local_bin_on_path(ctx)
            target = "" if spec in ("lts", "latest") else spec
            ctx.sh(f'"$HOME/.local/bin/uv" python install --default --preview {q(target) if target else ""}'.rstrip())
            version = first_version(ctx.probe(f'"$({LOCAL_BIN}/uv python find)" --version')) or self.resolve(ctx, spec, method)
        elif method == "pyenv":
            version = self.resolve(ctx, spec, method)
            ctx.apt.install(*self.PYENV_DEPS)
            if not (HOME / ".pyenv").exists():
                ctx.sh("curl -4 -fsSL --retry 3 --retry-delay 2 https://pyenv.run | bash")
            ctx.rc.add("pyenv", 'export PYENV_ROOT="$HOME/.pyenv"', 'export PATH="$PYENV_ROOT/bin:$PATH"',
                       'eval "$(pyenv init - $(basename "$SHELL"))"')
            ctx.sh(f'"$HOME/.pyenv/bin/pyenv" install --skip-existing {q(version)} && "$HOME/.pyenv/bin/pyenv" global {q(version)}')
        elif method == "mise":
            mise_use(ctx, "python", "latest" if spec in ("lts", "latest") else spec)
            version = mise_has(ctx, "python") or spec
        else:
            version = self.resolve(ctx, spec, method)
            minor = ".".join(version.split(".")[:2])
            if not ctx.apt.candidates(f"python{minor}"):
                self.add_deadsnakes(ctx, minor)
            ctx.apt.install(f"python{minor}", f"python{minor}-venv", f"python{minor}-dev")
            version = first_version(ctx.probe(f"python{minor} --version")) or version
            method = "deadsnakes"
            ctx.ui.info(f"run it as python{minor} (Ubuntu's own python3 is left alone; the OS depends on it)")
        ctx.state.set(self.id, method=method, version=version)
        return version

    DEADSNAKES_URL = "https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu"
    DEADSNAKES_FPR = "F23C5A6CF475977595C89F51BA6932366A755776"

    def add_deadsnakes(self, ctx: Ctx, minor: str) -> None:
        """Add the deadsnakes PPA directly (key via curl, verified by fingerprint).

        `add-apt-repository` is avoided on purpose: it calls Launchpad's API from Python,
        which can hang for minutes on hosts with broken IPv6 (common on WSL).
        """
        codename = ubuntu_codename()
        if not ctx.dry_run and ctx.probe(f"curl -4 -fsI --max-time 15 {self.DEADSNAKES_URL}/dists/{codename}/Release "
                                         ">/dev/null && echo ok") != "ok":
            raise CommandError(f"Python {minor} isn't in Ubuntu's repositories, and the deadsnakes PPA doesn't support "
                               f"Ubuntu '{codename}' (yet). Re-run and choose the uv or pyenv version manager instead.")
        ctx.apt.add_repo(
            "deadsnakes",
            f"https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0x{self.DEADSNAKES_FPR}",
            f"deb [signed-by={{key}}] {self.DEADSNAKES_URL} {codename} main",
            fingerprint=self.DEADSNAKES_FPR,
        )

    def uninstall(self, ctx: Ctx, det: Detected) -> None:
        if not det.managed:
            ctx.ui.warn("skipping Ubuntu's system python3: the OS depends on it")
            return
        st = ctx.state.get(self.id) or {}
        if det.method == "uv":
            ctx.sh(f'"{LOCAL_BIN}/uv" python uninstall --all || true; rm -f "{LOCAL_BIN}/uv" "{LOCAL_BIN}/uvx"; '
                   'rm -rf "$HOME/.local/share/uv"', check=False)
        elif det.method == "pyenv":
            ctx.sh('rm -rf "$HOME/.pyenv"')
            ctx.rc.remove("pyenv")
        elif det.method == "mise":
            mise_remove(ctx, "python")
        elif det.method == "deadsnakes":
            minor = ".".join(st.get("version", det.version).split(".")[:2])
            ctx.apt.purge(f"python{minor}", f"python{minor}-venv", f"python{minor}-dev")
            ctx.apt.remove_repo("deadsnakes")
            # also clean up a PPA added the old way (add-apt-repository naming)
            ctx.sh("rm -f /etc/apt/sources.list.d/deadsnakes-ubuntu-ppa-*.list /etc/apt/sources.list.d/deadsnakes-ubuntu-ppa-*.sources",
                   sudo=True, check=False)
        ctx.state.drop(self.id)


