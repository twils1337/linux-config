_HTTP_CACHE: Dict[str, object] = {}


def http_get(url: str) -> str:
    """GET a URL quickly or fail quickly.

    curl is tried first: it falls back from a broken IPv6 route to IPv4 in milliseconds
    (common on WSL), whereas Python's urllib waits out the full timeout per address.
    """
    if shutil.which("curl"):
        try:
            res = subprocess.run(
                ["curl", "-4", "-fsSL", "--connect-timeout", "5", "--max-time", "25", "--retry", "1",
                 "-A", f"config-me/{VERSION}", url],
                capture_output=True, timeout=60)
            if res.returncode == 0:
                return res.stdout.decode("utf-8", errors="replace")
            raise urllib.error.URLError(f"curl exit {res.returncode}: {res.stderr.decode(errors='replace').strip()}")
        except subprocess.TimeoutExpired as e:
            raise urllib.error.URLError(f"timed out fetching {url}") from e
    req = urllib.request.Request(url, headers={"User-Agent": f"config-me/{VERSION}"})
    with urllib.request.urlopen(req, timeout=8) as resp:
        return resp.read().decode("utf-8", errors="replace")


def http_json(url: str) -> object:
    if url in _HTTP_CACHE:
        return _HTTP_CACHE[url]
    data = json.loads(http_get(url))
    _HTTP_CACHE[url] = data
    return data


def http_text(url: str) -> str:
    return http_get(url)


def strip_prefix(s: str, prefix: str) -> str:
    return s[len(prefix):] if s.startswith(prefix) else s


def vkey(v: str) -> Tuple[int, ...]:
    """Sort key for version strings: '1.22.10' > '1.22.9'."""
    return tuple(int(x) for x in re.findall(r"\d+", v)) or (0,)


def pick_version(candidates: Sequence[str], spec: str) -> Optional[str]:
    """Pick the newest candidate matching `spec` ('22' → newest 22.x, '22.1.0' → exact)."""
    spec = spec.lstrip("vV").strip()
    parts = spec.split(".")
    matches = []
    for c in candidates:
        cv = c.lstrip("vV")
        cparts = re.split(r"[.]", cv)
        if cv == spec or cparts[: len(parts)] == parts:
            matches.append(c)
    return max(matches, key=vkey) if matches else None


def arch() -> Tuple[str, str]:
    """(dpkg/go-style arch, node/rust-style arch)."""
    m = platform.machine().lower()
    if m in ("x86_64", "amd64"):
        return "amd64", "x64"
    if m in ("aarch64", "arm64"):
        return "arm64", "arm64"
    return m, m


def is_wsl() -> bool:
    try:
        return "microsoft" in Path("/proc/version").read_text().lower()
    except OSError:
        return False


def has_systemd() -> bool:
    try:
        return Path("/proc/1/comm").read_text().strip() == "systemd"
    except OSError:
        return False


def ubuntu_codename() -> str:
    try:
        for line in Path("/etc/os-release").read_text().splitlines():
            if line.startswith("VERSION_CODENAME="):
                return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "noble"


def target_user() -> str:
    return os.environ.get("SUDO_USER") or getpass.getuser()


# =============================================================================
# apt (with smart `apt-get update`)
# =============================================================================

class Apt:
    LOCK = "-o DPkg::Lock::Timeout=300"

    def __init__(self, runner: Runner):
        self.r = runner
        self.fresh = False

    def lists_age(self) -> float:
        lists = Path("/var/lib/apt/lists")
        newest = 0.0
        try:
            for p in lists.iterdir():
                if p.is_file() and p.name not in ("lock",):
                    newest = max(newest, p.stat().st_mtime)
        except OSError:
            return float("inf")
        return time.time() - newest if newest else float("inf")

    def update(self, force: bool = False) -> None:
        """Run apt-get update once per run, and only when lists are stale or a repo changed."""
        if self.fresh and not force:
            return
        if not force and self.lists_age() < APT_MAX_AGE_SECS:
            self.r.ui.info(self.r.ui.dim("package lists are fresh; skipping apt-get update"))
            self.fresh = True
            return
        self.announce_lock()
        self.r.run(f"apt-get {self.LOCK} update -y", sudo=True)
        self.fresh = True

    def lock_holder(self) -> Optional[str]:
        out = self.r.capture("pgrep -a -f 'unattended-upgr|apt-get|apt |dpkg ' | grep -v pgrep | head -1")
        return out or None

    def announce_lock(self) -> None:
        holder = self.lock_holder()
        if holder and not self.r.dry_run:
            name = "unattended-upgrades" if "unattended" in holder else holder.split()[1] if len(holder.split()) > 1 else holder
            self.r.ui.warn(f"another package manager process is running ({name}); waiting for it to finish…")

    def install(self, *pkgs: str) -> None:
        if not pkgs:
            return
        self.update()
        self.announce_lock()
        self.r.run(f"apt-get {self.LOCK} install -y --no-install-recommends {' '.join(pkgs)}", sudo=True)

    def purge(self, *pkgs: str) -> None:
        installed = [p for p in pkgs if self.installed(p) or "*" in p]
        if installed:
            self.r.run(f"apt-get {self.LOCK} purge -y {' '.join(installed)} && apt-get {self.LOCK} autoremove -y",
                       sudo=True, check=False)

    def installed(self, pkg: str) -> bool:
        out = self.r.capture(f"dpkg-query -W -f='${{Status}}' {q(pkg)} 2>/dev/null")
        return bool(out and "install ok installed" in out)

    def version(self, pkg: str) -> Optional[str]:
        return self.r.capture(f"dpkg-query -W -f='${{Version}}' {q(pkg)} 2>/dev/null") if self.installed(pkg) else None

    def candidates(self, pkg: str) -> List[str]:
        out = self.r.capture(f"apt-cache madison {q(pkg)}") or ""
        return [line.split("|")[1].strip() for line in out.splitlines() if line.count("|") >= 2]

    def add_repo(self, name: str, key_url: str, source: str, armored_key: bool = True,
                 fingerprint: str = "") -> None:
        """Add a signed third-party repository (keyring in /etc/apt/keyrings).

        With `fingerprint`, the downloaded key is refused unless it has exactly that fingerprint.
        """
        self.install("ca-certificates", "curl", "gnupg")
        key = f"/etc/apt/keyrings/{name}.gpg"
        fetch = f"curl -4 -fsSL --retry 3 --retry-delay 2 {q(key_url)}"
        dearmor = f" | gpg --dearmor --yes -o {key}" if armored_key else f" -o {key}"
        verify = ""
        if fingerprint:
            verify = (f" && gpg --show-keys --with-colons {key} | grep -q '^fpr:::::::::{fingerprint}:'"
                      f" || {{ rm -f {key}; echo 'signing key fingerprint mismatch for {name}; refusing it' >&2; exit 1; }}")
        self.r.run(f"install -m 0755 -d /etc/apt/keyrings && {fetch}{dearmor} && chmod a+r {key}{verify}", sudo=True)
        line = source.replace("{key}", key)
        self.r.run(f"echo {q(line)} > /etc/apt/sources.list.d/{name}.list", sudo=True)
        self.update(force=True)

    def remove_repo(self, name: str) -> None:
        self.r.run(f"rm -f /etc/apt/sources.list.d/{name}.list /etc/apt/keyrings/{name}.gpg", sudo=True, check=False)
        self.fresh = False


# =============================================================================
# Shell rc integration (~/.bashrc, ~/.zshrc)
# =============================================================================

class ShellRc:
    """Manages a marked block in shell rc files. Each line is tagged `# config-me:<tag>`."""

    def __init__(self, ui: UI, dry_run: bool = False):
        self.ui = ui
        self.dry_run = dry_run

    @staticmethod
    def files() -> List[Path]:
        files = [HOME / ".bashrc"]
        if (HOME / ".zshrc").exists():
            files.append(HOME / ".zshrc")
        return files

    @staticmethod
    def _split(text: str) -> Tuple[str, List[str], str]:
        if RC_BEGIN in text and RC_END in text:
            pre, rest = text.split(RC_BEGIN, 1)
            body, post = rest.split(RC_END, 1)
            return pre, [line for line in body.strip("\n").splitlines() if line.strip()], post
        return text, [], ""

    @staticmethod
    def _join(pre: str, body: List[str], post: str) -> str:
        if not body:
            return pre.rstrip("\n") + ("\n" if pre.strip() else "") + post.lstrip("\n")
        block = "\n".join([RC_BEGIN, "# Managed by config-me. Edit with care; lines are added/removed by tag.", *body, RC_END])
        sep = "" if not pre or pre.endswith("\n\n") else ("\n" if pre.endswith("\n") else "\n\n")
        return pre + sep + block + "\n" + post.lstrip("\n")

    def add(self, tag: str, *lines: str) -> None:
        """Add a tool's lines if they're missing. If the tool already has lines (tag present),
        the file is left untouched, including any edits you made to those lines."""
        for f in self.files():
            text = f.read_text() if f.exists() else ""
            pre, body, post = self._split(text)
            if any(b.endswith(f"# config-me:{tag}") for b in body):
                continue
            body = [b for b in body if not b.startswith("# Managed by config-me")]
            body += [f"{line}  # config-me:{tag}" for line in lines]
            self.ui.info(self.ui.dim(f"adding {tag} setup to {f}"))
            if not self.dry_run:
                f.write_text(self._join(pre, body, post))

    def remove(self, tag: str) -> None:
        for f in self.files():
            if not f.exists():
                continue
            text = f.read_text()
            pre, body, post = self._split(text)
            kept = [b for b in body if not b.endswith(f"# config-me:{tag}") and not b.startswith("# Managed by config-me")]
            if len(kept) != len([b for b in body if not b.startswith("# Managed by config-me")]):
                self.ui.info(self.ui.dim(f"removing {tag} lines from {f}"))
                if not self.dry_run:
                    f.write_text(self._join(pre, kept, post))


# =============================================================================
# Persistent state (what config-me installed, and how)
# =============================================================================

class State:
    def __init__(self, dry_run: bool = False):
        self.dry_run = dry_run
        try:
            self.data = json.loads(STATE_FILE.read_text())
        except (OSError, ValueError):
            self.data = {"items": {}}
        self.data.setdefault("items", {})

    def get(self, item_id: str) -> Optional[dict]:
        return self.data["items"].get(item_id)

    def set(self, item_id: str, **info: str) -> None:
        info["updated"] = _dt.datetime.now().isoformat(timespec="seconds")
        self.data["items"][item_id] = info
        self._save()

    def drop(self, item_id: str) -> None:
        self.data["items"].pop(item_id, None)
        self._save()

    def _save(self) -> None:
        if self.dry_run:
            return
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        STATE_FILE.write_text(json.dumps(self.data, indent=2, sort_keys=True))


# =============================================================================
# Context shared by every item
# =============================================================================

@dataclass
class Ctx:
    ui: UI
    run: Runner
    apt: Apt
    rc: ShellRc
    state: State
    dry_run: bool = False
    # Filled up front by prefetch(), so questions never wait on the network or on probes.
    detected: Dict[str, Optional["Detected"]] = field(default_factory=dict)
    hints: Dict[str, str] = field(default_factory=dict)

    def detect(self, item: "Item") -> Optional["Detected"]:
        if item.id not in self.detected:
            self.detected[item.id] = item.detect(self)
        return self.detected[item.id]

    def hint(self, item: "Item") -> str:
        if item.id not in self.hints:
            self.hints[item.id] = item.version_hint()
        return self.hints[item.id]

    def sh(self, cmd: str, **kw) -> Tuple[int, str]:
        return self.run.run(cmd, **kw)

    def probe(self, cmd: str) -> Optional[str]:
        return self.run.capture(cmd)


@dataclass
class Detected:
    version: str
    method: str          # how it was installed (e.g. "tarball", "nvm", "apt", "unknown")
    path: str = ""
    managed: bool = True  # False for things config-me must never remove (system python)
    problem: str = ""     # installed but broken in the user's environment (shown by -stat and prompts)


def first_version(text: Optional[str]) -> Optional[str]:
    if not text:
        return None
    m = re.search(r"(\d+\.\d+(?:\.\d+)?(?:[-+._][0-9A-Za-z.]+)?)", text)
    return m.group(1) if m else None


# =============================================================================
# Shared installers: mise and the npm "user prefix"
# =============================================================================

MISE = LOCAL_BIN / "mise"


def ensure_mise(ctx: Ctx) -> None:
    if not (MISE.exists() or shutil.which("mise")):
        ctx.ui.info("installing mise (polyglot version manager)")
        ctx.apt.install("curl", "ca-certificates")
        ctx.sh("curl -4 -fsSL --retry 3 --retry-delay 2 https://mise.run | sh")
        ctx.state.set("_mise", method="mise.run", version="latest")
    # Always (re)wire the shell, even if the manager was already there: a missing rc line
    # is exactly what makes "installed" tools look absent in new terminals.
    if MISE.exists() or ctx.dry_run:
        ctx.rc.add("mise", 'eval "$($HOME/.local/bin/mise activate $(basename "$SHELL"))"')


def mise_bin() -> str:
    return str(MISE) if MISE.exists() else "mise"


def mise_use(ctx: Ctx, tool: str, version: str) -> None:
    ensure_mise(ctx)
    ctx.sh(f"{mise_bin()} use --global --yes {q(f'{tool}@{version}')}")


def mise_remove(ctx: Ctx, tool: str) -> None:
    ctx.sh(f"{mise_bin()} unuse --global --yes {q(tool)} || true", check=False)
    ctx.sh(f"{mise_bin()} uninstall --all --yes {q(tool)} || true", check=False)


def mise_has(ctx: Ctx, tool: str) -> Optional[str]:
    out = ctx.probe(f"{mise_bin()} ls --global --json {q(tool)} 2>/dev/null")
    try:
        entries = json.loads(out) if out else []
        if entries:
            return entries[-1].get("version")
    except ValueError:
        pass
    return None


def ensure_node_for_npm(ctx: Ctx, min_major: int = 20) -> None:
    out = ctx.probe("node --version")
    if out and vkey(out)[0] >= min_major and ctx.probe("npm --version"):
        return
    ctx.ui.info(f"Node.js {min_major}+ is required; installing the latest Node LTS first")
    node = ITEMS["node"]
    node.install(ctx, "lts", node.default_method)


NPM_PREFIX = HOME / ".local"


def npm_global(ctx: Ctx, args: str) -> None:
    """npm -g into ~/.local (no sudo, works with any Node install method)."""
    ctx.sh(f"npm {args} --global --prefix {q(str(NPM_PREFIX))} --no-fund --no-audit")


def ensure_local_bin_on_path(ctx: Ctx) -> None:
    ctx.rc.add("local-bin", 'case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac')


# =============================================================================
# Items: the software config-me manages
# =============================================================================

class Item:
    id = ""
    name = ""
    section = ""
    default_method = ""
    managers: List[Tuple[str, str]] = []   # (key, description) of optional version managers
    has_lts = True
    example = "1.2.3"

    # --- versions ---------------------------------------------------------------
    def lts(self) -> str:
        return self.latest()

    def latest(self) -> str:
        raise NotImplementedError

    def resolve(self, ctx: Ctx, spec: str, method: str) -> str:
        """Turn 'lts' / 'latest' / '22' into what the installer needs."""
        if not ctx.dry_run and (spec in ("lts", "latest") or self.resolve_needs_lookup(spec)):
            ctx.ui.info(ctx.ui.dim(f"looking up the {'LTS' if spec == 'lts' and self.has_lts else spec} version of {self.name}…"))
        try:
            if spec == "lts":
                return self.lts()
            if spec == "latest":
                return self.latest()
            return self.resolve_specific(spec, method)
        except (urllib.error.URLError, OSError, ValueError, KeyError) as e:
            if ctx.dry_run:
                return f"<{spec}>"
            raise CommandError(f"couldn't look up {self.name} versions: {e}") from e

    def resolve_specific(self, spec: str, method: str) -> str:
        return spec.lstrip("vV")

    def resolve_needs_lookup(self, spec: str) -> bool:
        return type(self).resolve_specific is not Item.resolve_specific

    def version_hint(self) -> str:
        try:
            lts, latest = self.lts(), self.latest()
        except Exception:  # noqa: BLE001 - only a hint
            return ""
        if not self.has_lts or lts == latest:
            return f"latest={latest}"
        return f"LTS={lts}, latest={latest}"

    # --- lifecycle --------------------------------------------------------------
    def detect(self, ctx: Ctx) -> Optional[Detected]:
        raise NotImplementedError

    def install(self, ctx: Ctx, spec: str, method: str) -> str:
        raise NotImplementedError

    def uninstall(self, ctx: Ctx, det: Detected) -> None:
        raise NotImplementedError

    def method_of(self, ctx: Ctx, default: str = "unknown") -> str:
        st = ctx.state.get(self.id)
        return st["method"] if st else default


# ----------------------------------------------------------------------------- Node

class Node(Item):
    example = "22 or 22.11.0"
    id, name, section = "node", "Node.js", "lang"
    default_method = "official"
    managers = [("nvm", "nvm (Node Version Manager)"), ("fnm", "fnm (fast, Rust-based)"), ("mise", "mise (polyglot)")]
    INDEX = "https://nodejs.org/dist/index.json"
    PREFIX = Path("/usr/local/lib/nodejs")

    def _index(self) -> list:
        """Stable releases only: nodejs.org also lists prereleases like v27.0.0-alpha.0."""
        return [r for r in http_json(self.INDEX) if re.fullmatch(r"v\d+\.\d+\.\d+", r["version"])]  # type: ignore[union-attr]

    def lts(self) -> str:
        return next(r["version"] for r in self._index() if r.get("lts"))

    def latest(self) -> str:
        return self._index()[0]["version"]

    def resolve_specific(self, spec: str, method: str) -> str:
        v = pick_version([r["version"] for r in self._index()], spec)
        if not v:
            raise ValueError(f"no Node.js release matches {spec!r}")
        return v

    def detect(self, ctx: Ctx) -> Optional[Detected]:
        out = ctx.probe("node --version")
        if not out:
            return None
        path = ctx.probe("command -v node") or ""
        method = self.method_of(ctx, "")
        if not method:
            if ".nvm" in path:
                method = "nvm"
            elif "fnm" in path:
                method = "fnm"
            elif "mise" in path:
                method = "mise"
            elif path.startswith("/usr/local/bin") and self.PREFIX.exists():
                method = "official"
            elif ctx.apt.installed("nodejs"):
                method = "apt"
            else:
                method = "unknown"
        return Detected(out.lstrip("v"), method, path)

    def install(self, ctx: Ctx, spec: str, method: str) -> str:
        ctx.apt.install("libatomic1")  # recent Node builds link against it; minimal images lack it
        if method == "nvm":
            version = self.resolve(ctx, spec, method).lstrip("v")
            if not (HOME / ".nvm" / "nvm.sh").exists():
                ctx.apt.install("curl", "ca-certificates")
                tag = "v0.40.3"
                try:
                    tag = http_json("https://api.github.com/repos/nvm-sh/nvm/releases/latest")["tag_name"]  # type: ignore[index]
                except Exception:  # noqa: BLE001 - fall back to a known release
                    pass
                ctx.sh(f"curl -4 -fsSL --retry 3 --retry-delay 2 https://raw.githubusercontent.com/nvm-sh/nvm/{tag}/install.sh | PROFILE=/dev/null bash")
            ctx.rc.add("nvm", 'export NVM_DIR="$HOME/.nvm"', '[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"')
            ctx.sh(f'. "$HOME/.nvm/nvm.sh" && nvm install {q(version)} && nvm alias default {q(version)}')
        elif method == "fnm":
            version = self.resolve(ctx, spec, method).lstrip("v")
            fnm = HOME / ".local" / "share" / "fnm" / "fnm"
            if not fnm.exists():
                ctx.apt.install("curl", "unzip", "ca-certificates")
                ctx.sh('curl -4 -fsSL --retry 3 --retry-delay 2 https://fnm.vercel.app/install | bash -s -- --skip-shell --install-dir "$HOME/.local/share/fnm"')
            ctx.rc.add("fnm", 'export PATH="$HOME/.local/share/fnm:$PATH"', 'eval "$(fnm env --use-on-cd --shell $(basename "$SHELL"))"')
            ctx.sh(f"{fnm} install {q(version)} && {fnm} default {q(version)}")
        elif method == "mise":
            mise_use(ctx, "node", spec.lstrip("vV"))
            version = mise_has(ctx, "node") or spec
        else:
            version = self.resolve(ctx, spec, method).lstrip("v")
            _, narch = arch()
            pkg = f"node-v{version}-linux-{narch}"
            url = f"https://nodejs.org/dist/v{version}/{pkg}.tar.xz"
            ctx.apt.install("curl", "xz-utils", "ca-certificates")
            ctx.sh(
                f"rm -rf {self.PREFIX} && mkdir -p {self.PREFIX} && "
                f"curl -4 -fsSL --retry 3 --retry-delay 2 {url} | tar -xJ -C {self.PREFIX} && "
                f"for b in node npm npx corepack; do ln -sf {self.PREFIX}/{pkg}/bin/$b /usr/local/bin/$b; done",
                sudo=True,
            )
            method = "official"
        ctx.state.set(self.id, method=method, version=version)
        return version

    def uninstall(self, ctx: Ctx, det: Detected) -> None:
        m = det.method
        if m == "nvm":
            ctx.sh('rm -rf "$HOME/.nvm"')
            ctx.rc.remove("nvm")
        elif m == "fnm":
            ctx.sh('rm -rf "$HOME/.local/share/fnm" "$HOME/.local/state/fnm_multishells"')
            ctx.rc.remove("fnm")
        elif m == "mise":
            mise_remove(ctx, "node")
        elif m == "apt":
            ctx.apt.purge("nodejs")
        else:
            ctx.sh(f"rm -rf {self.PREFIX} && rm -f /usr/local/bin/node /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack",
                   sudo=True)
        ctx.state.drop(self.id)


