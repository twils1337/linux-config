# =============================================================================
# Output: colours, logging, progress bar
# =============================================================================

class UI:
    def __init__(self, mute: bool = False):
        self.mute = mute
        self.tty = sys.stdout.isatty()
        self.color = self.tty and not os.environ.get("NO_COLOR")
        self._log_fh = None
        self._bar: Optional[Tuple[int, int, str]] = None
        self._lock = threading.Lock()

    # -- colours -------------------------------------------------------------
    def c(self, text: str, code: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.color else text

    def bold(self, t: str) -> str: return self.c(t, "1")
    def dim(self, t: str) -> str: return self.c(t, "2")
    def green(self, t: str) -> str: return self.c(t, "32")
    def yellow(self, t: str) -> str: return self.c(t, "33")
    def red(self, t: str) -> str: return self.c(t, "31")
    def cyan(self, t: str) -> str: return self.c(t, "36")

    # -- log file ------------------------------------------------------------
    def open_log(self) -> None:
        try:
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            self._log_fh = open(LOG_FILE, "a", encoding="utf-8")
            self._log_fh.write(f"\n===== config-me {VERSION} run at {_dt.datetime.now().isoformat()} =====\n")
        except OSError:
            self._log_fh = None

    def to_file(self, line: str) -> None:
        if self._log_fh:
            self._log_fh.write(line.rstrip("\n") + "\n")
            self._log_fh.flush()

    # -- messages ------------------------------------------------------------
    def _emit(self, line: str, plain: str, force: bool = False) -> None:
        self.to_file(plain)
        if self.mute and not force:
            return
        with self._lock:
            self._clear_bar()
            print(line, flush=True)
            self._draw_bar()

    def step(self, msg: str) -> None: self._emit(self.bold(self.cyan("==> ")) + self.bold(msg), f"==> {msg}")
    def info(self, msg: str) -> None: self._emit("    " + msg, f"    {msg}")
    def ok(self, msg: str) -> None: self._emit(self.green("  ✓ ") + msg, f"  OK {msg}")
    def warn(self, msg: str) -> None: self._emit(self.yellow("  ! ") + msg, f"  WARN {msg}", force=True)
    def error(self, msg: str) -> None: self._emit(self.red("  ✗ ") + msg, f"  ERROR {msg}", force=True)
    def cmd(self, msg: str) -> None: self._emit(self.dim("  $ " + msg), f"  $ {msg}")

    def waiting(self, msg: str) -> None:
        """A 'still working' notice: shown as a log line, or in the progress bar label with -mute."""
        self.to_file(f"  ... {msg}")
        if self.mute:
            with self._lock:
                if self._bar:
                    done, total, label = self._bar
                    base = label.split("  ·  ")[0]
                    self._bar = (done, total, f"{base}  ·  {msg}")
                    self._draw_bar()
            return
        with self._lock:
            print(self.yellow("  … ") + self.dim(msg), flush=True)
    def out(self, msg: str) -> None: self._emit(self.dim("  │ " + msg), f"  | {msg}")

    def say(self, msg: str = "") -> None:
        """Always shown (prompts, summaries), never only logged."""
        self.to_file(re.sub(r"\033\[[0-9;]*m", "", msg))
        with self._lock:
            self._clear_bar()
            print(msg, flush=True)
            self._draw_bar()

    # -- progress bar (used with -mute) ----------------------------------------
    def bar(self, done: int, total: int, label: str) -> None:
        if not self.mute:
            return
        with self._lock:
            self._bar = (done, total, label)
            self._draw_bar()

    def end_bar(self) -> None:
        with self._lock:
            self._clear_bar()
            self._bar = None

    def _draw_bar(self) -> None:
        if not (self.mute and self._bar):
            return
        done, total, label = self._bar
        width = 30
        filled = int(width * done / total) if total else width
        pct = int(100 * done / total) if total else 100
        cols = shutil.get_terminal_size((100, 20)).columns
        text = f"[{'█' * filled}{'░' * (width - filled)}] {pct:3d}% ({done}/{total}) {label}"
        text = text[: max(10, cols - 1)]
        if self.tty:
            sys.stdout.write("\r\033[K" + text)
            sys.stdout.flush()
        else:
            print(text, flush=True)

    def _clear_bar(self) -> None:
        if self.mute and self._bar and self.tty:
            sys.stdout.write("\r\033[K")
            sys.stdout.flush()


# =============================================================================
# Running commands
# =============================================================================

class CommandError(RuntimeError):
    pass


class Runner:
    def __init__(self, ui: UI, dry_run: bool = False):
        self.ui = ui
        self.dry_run = dry_run
        self.is_root = os.geteuid() == 0
        self._sudo_ok = self.is_root

    def env(self) -> Dict[str, str]:
        env = dict(os.environ)
        extra = [
            str(LOCAL_BIN), str(HOME / ".cargo" / "bin"), str(HOME / ".dotnet"),
            str(HOME / ".local" / "share" / "fnm"), str(HOME / ".pyenv" / "bin"),
            "/usr/local/go/bin", str(HOME / "go" / "bin"),
            str(HOME / ".local" / "share" / "mise" / "shims"),
        ]
        env["PATH"] = os.pathsep.join(extra + [env.get("PATH", "")])
        env.setdefault("DEBIAN_FRONTEND", "noninteractive")
        env.setdefault("NEEDRESTART_MODE", "a")  # don't stop for needrestart's "restart services?" dialog
        return env

    def ensure_sudo(self) -> None:
        if self._sudo_ok or self.dry_run:
            return
        if not shutil.which("sudo"):
            raise CommandError("this step needs root, but sudo isn't installed (run config-me as root)")
        self.ui.end_bar()
        self.ui.say(self.ui.dim("    (sudo is needed for system packages)"))
        if subprocess.call(["sudo", "-v"]) != 0:
            raise CommandError("sudo authentication failed")
        self._sudo_ok = True
        threading.Thread(target=self._keep_sudo_alive, daemon=True).start()

    @staticmethod
    def _keep_sudo_alive() -> None:
        while True:
            time.sleep(60)
            subprocess.call(["sudo", "-n", "-v"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def run(self, cmd: str, sudo: bool = False, check: bool = True, quiet: bool = False,
            env: Optional[Dict[str, str]] = None) -> Tuple[int, str]:
        """Run a bash command line. Returns (exit code, combined output)."""
        if sudo and not self.is_root:
            self.ensure_sudo()
            # `sudo -E` isn't supported by sudo-rs (Ubuntu 25.10+), so pass what we need explicitly.
            passed = {"DEBIAN_FRONTEND": "noninteractive", "NEEDRESTART_MODE": "a", **(env or {})}
            full = ["sudo", "env", *[f"{k}={v}" for k, v in passed.items()], "bash", "-o", "pipefail", "-c", cmd]
        else:
            full = ["bash", "-o", "pipefail", "-c", cmd]
        self.ui.cmd(("sudo " if sudo and not self.is_root else "") + cmd)
        if self.dry_run:
            return 0, ""
        run_env = self.env()
        if env:
            run_env.update(env)
        proc = subprocess.Popen(full, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, env=run_env, text=True,
                                errors="replace", bufsize=1)
        lines: List[str] = []
        assert proc.stdout is not None
        started = last_output = time.time()
        finished = threading.Event()
        what = self.describe(cmd)

        def heartbeat() -> None:
            # Long silent steps (downloads, compiles, apt waiting for a lock) must not look frozen.
            nonlocal last_output
            while not finished.wait(1):
                quiet_for = time.time() - last_output
                if quiet_for >= 15:
                    self.ui.waiting(f"still {what}… ({int(time.time() - started)}s so far)")
                    last_output = time.time()

        threading.Thread(target=heartbeat, daemon=True).start()
        try:
            for line in proc.stdout:
                last_output = time.time()
                line = line.rstrip("\n")
                lines.append(line)
                if quiet:
                    self.ui.to_file("  | " + line)
                else:
                    self.ui.out(line)
            code = proc.wait()
        finally:
            finished.set()
            proc.stdout.close()
        output = "\n".join(lines)
        if check and code != 0:
            tail = "\n".join(lines[-15:])
            raise CommandError(f"command failed (exit {code}): {cmd}\n{tail}")
        return code, output

    # Version managers that only work once their init script is sourced (as a login shell would).
    PROBE_PRELUDE = (
        '[ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1; '
        '[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ] && . "$HOME/.sdkman/bin/sdkman-init.sh" >/dev/null 2>&1; '
        '[ -x "$HOME/.local/share/fnm/fnm" ] && eval "$("$HOME/.local/share/fnm/fnm" env)" >/dev/null 2>&1; '
        '[ -x "$HOME/.pyenv/bin/pyenv" ] && eval "$("$HOME/.pyenv/bin/pyenv" init - bash)" >/dev/null 2>&1; '
        "true; "
    )

    @staticmethod
    def describe(cmd: str) -> str:
        """A human phrase for what a command is doing, for "still …" messages."""
        c = cmd.lower()
        if "apt-get" in c and " update" in c:
            return "refreshing apt package lists"
        if "apt-get" in c and " install" in c:
            return "installing packages with apt (it waits if another apt/dpkg process holds the lock)"
        if "apt-get" in c and " purge" in c:
            return "removing packages with apt"
        if "add-apt-repository" in c:
            return "adding the apt repository (contacting Launchpad)"
        if "curl" in c or "wget" in c:
            return "downloading"
        if "pyenv\" install" in c or "pyenv install" in c:
            return "building Python from source (this takes a few minutes)"
        if "npm " in c:
            return "installing npm packages"
        if "nvm install" in c or "fnm" in c or "mise" in c or "sdk install" in c or "uv\" python" in c:
            return "downloading and installing with the version manager"
        return "working"

    def capture(self, cmd: str) -> Optional[str]:
        """Run a read-only probe command, even in dry-run. Returns stdout or None."""
        try:
            res = subprocess.run(["bash", "-c", self.PROBE_PRELUDE + cmd], capture_output=True, text=True,
                                 env=self.env(), timeout=30, errors="replace")
        except (OSError, subprocess.TimeoutExpired):
            return None
        if res.returncode != 0:
            return None
        return (res.stdout + res.stderr).strip()


def itertools_count(start: float = 0, step: float = 1):
    """Monotonic fake clock helper (used by tests)."""
    it = itertools.count(start, step)
    return lambda: next(it)


def q(s: str) -> str:
    return shlex.quote(s)


