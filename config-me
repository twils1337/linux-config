class DotNet(Item):
    example = "8 or 8.0.404"
    id, name, section = "dotnet", "C# (.NET SDK)", "lang"
    default_method = "dotnet-install"
    managers = [("mise", "mise (polyglot)")]
    INDEX = "https://dotnetcli.blob.core.windows.net/dotnet/release-metadata/releases-index.json"
    ROOT = HOME / ".dotnet"

    def _channels(self) -> list:
        data = http_json(self.INDEX)
        return [c for c in data["releases-index"] if c.get("support-phase") not in ("preview", "eol")]  # type: ignore[index]

    def lts(self) -> str:
        chans = [c for c in self._channels() if c.get("release-type") == "lts"]
        return max(chans, key=lambda c: vkey(c["channel-version"]))["latest-sdk"]

    def latest(self) -> str:
        return max(self._channels(), key=lambda c: vkey(c["channel-version"]))["latest-sdk"]

    def resolve_specific(self, spec: str, method: str) -> str:
        spec = spec.strip()
        if spec.count(".") >= 2:          # a full SDK version like 8.0.404
            return spec
        chan = spec if "." in spec else f"{spec}.0"
        data = http_json(self.INDEX)
        for c in data["releases-index"]:  # type: ignore[index]
            if c["channel-version"] == chan:
                return c["latest-sdk"]
        raise ValueError(f"no .NET channel {chan}")

    def detect(self, ctx: Ctx) -> Optional[Detected]:
        out = ctx.probe("dotnet --list-sdks")
        if not out:
            return None
        versions = [line.split()[0] for line in out.splitlines() if line.strip()]
        path = ctx.probe("command -v dotnet") or ""
        method = self.method_of(ctx, "")
        if not method:
            method = "mise" if "mise" in path else "dotnet-install" if str(self.ROOT) in path or self.ROOT.exists() else (
                "apt" if ctx.apt.installed("dotnet-host") or ctx.apt.installed("dotnet-host-8.0") else "unknown")
        return Detected(", ".join(sorted(versions, key=vkey)), method, path)

    def install(self, ctx: Ctx, spec: str, method: str) -> str:
        ctx.apt.install("curl", "ca-certificates", "libicu-dev")
        if method == "mise":
            mise_use(ctx, "dotnet", self.resolve(ctx, spec, method))
            version = mise_has(ctx, "dotnet") or spec
        else:
            version = self.resolve(ctx, spec, method)
            ctx.sh(f'curl -4 -fsSL --retry 3 --retry-delay 2 https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh && '
                   f'bash /tmp/dotnet-install.sh --version {q(version)} --install-dir "$HOME/.dotnet" && rm -f /tmp/dotnet-install.sh')
            ctx.rc.add("dotnet", 'export DOTNET_ROOT="$HOME/.dotnet"', 'export PATH="$DOTNET_ROOT:$DOTNET_ROOT/tools:$PATH"',
                       "export DOTNET_CLI_TELEMETRY_OPTOUT=1")
            method = "dotnet-install"
        ctx.state.set(self.id, method=method, version=version)
        return version

    def uninstall(self, ctx: Ctx, det: Detected) -> None:
        if det.method == "mise":
            mise_remove(ctx, "dotnet")
        elif det.method == "apt":
            ctx.apt.purge("dotnet*", "aspnetcore*", "netstandard*")
        else:
            ctx.sh('rm -rf "$HOME/.dotnet"')
            ctx.rc.remove("dotnet")
        ctx.state.drop(self.id)


