class Java(Item):
    example = "21"
    id, name, section = "java", "Java (Eclipse Temurin JDK)", "lang"
    default_method = "temurin-apt"
    managers = [("sdkman", "SDKMAN! (the JVM ecosystem's manager)"), ("mise", "mise (polyglot)")]
    API = "https://api.adoptium.net/v3/info/available_releases"

    def _info(self) -> dict:
        return http_json(self.API)  # type: ignore[return-value]

    def lts(self) -> str:
        return str(self._info()["most_recent_lts"])

    def latest(self) -> str:
        return str(self._info()["most_recent_feature_release"])

    def resolve_specific(self, spec: str, method: str) -> str:
        if method == "sdkman" and "-" in spec:   # full SDKMAN id like 21.0.5-tem
            return spec
        major = spec.split(".")[0]
        if not major.isdigit():
            raise ValueError(f"Java versions are majors like 21 (got {spec!r})")
        return major

    def detect(self, ctx: Ctx) -> Optional[Detected]:
        out = ctx.probe("java -version 2>&1")
        if not out or "version" not in out:
            return None
        m = re.search(r'version "([^"]+)"', out)
        path = ctx.probe("readlink -f \"$(command -v java)\"") or ""
        method = self.method_of(ctx, "")
        if not method:
            method = ("sdkman" if ".sdkman" in path else "mise" if "mise" in path else
                      "temurin-apt" if "temurin" in path else "apt" if path.startswith("/usr/lib/jvm") else "unknown")
        return Detected(m.group(1) if m else first_version(out) or "?", method, path)

    def _sdkman_id(self, ctx: Ctx, major: str) -> str:
        """Newest Temurin identifier (e.g. 21.0.9-tem) for a major, from SDKMAN itself."""
        text = ctx.probe('. "$HOME/.sdkman/bin/sdkman-init.sh" && PAGER=cat sdk list java') or ""
        if "-tem" not in text:
            platform_id = "linuxarm64" if arch()[0] == "arm64" else "linuxx64"
            try:
                text = http_text(f"https://api.sdkman.io/2/candidates/java/{platform_id}/versions/list?installed=")
            except (urllib.error.URLError, OSError):
                text = ""
        ids = re.findall(rf"(?<![\d.])({re.escape(major)}(?:\.\d+)*(?:\+\d+)?-tem)\b", text)
        if not ids:
            raise ValueError(f"no Temurin {major} on SDKMAN")
        return max(set(ids), key=vkey)

    def install(self, ctx: Ctx, spec: str, method: str) -> str:
        major = self.resolve(ctx, spec, method)
        if method == "sdkman":
            if not (HOME / ".sdkman").exists():
                ctx.apt.install("curl", "zip", "unzip", "ca-certificates")
                ctx.sh('curl -4 -fsSL --retry 3 --retry-delay 2 "https://get.sdkman.io?rcupdate=false" | bash')
                # SDKMAN reads its settings from etc/config, not the environment: answer prompts with yes.
                ctx.sh('sed -i "s/^sdkman_auto_answer=.*/sdkman_auto_answer=true/" "$HOME/.sdkman/etc/config"')
            ctx.rc.add("sdkman", 'export SDKMAN_DIR="$HOME/.sdkman"',
                       '[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ] && . "$SDKMAN_DIR/bin/sdkman-init.sh"')
            ident = major if "-" in major else (self._sdkman_id(ctx, major) if not ctx.dry_run else f"{major}-tem")
            ctx.sh(f'. "$HOME/.sdkman/bin/sdkman-init.sh" && sdk install java {q(ident)} < /dev/null && sdk default java {q(ident)}')
            version = ident
        elif method == "mise":
            mise_use(ctx, "java", f"temurin-{major}")
            version = mise_has(ctx, "java") or major
        else:
            arch_dpkg, _ = arch()
            ctx.apt.add_repo("adoptium", "https://packages.adoptium.net/artifactory/api/gpg/key/public",
                             f"deb [arch={arch_dpkg} signed-by={{key}}] https://packages.adoptium.net/artifactory/deb "
                             f"{ubuntu_codename()} main")
            ctx.apt.install(f"temurin-{major}-jdk")
            ctx.sh(f"update-java-alternatives -s temurin-{major}-jdk-{arch_dpkg} || true", sudo=True, check=False)
            version = ctx.apt.version(f"temurin-{major}-jdk") or major
            method = "temurin-apt"
        ctx.state.set(self.id, method=method, version=version)
        return version

    def uninstall(self, ctx: Ctx, det: Detected) -> None:
        if det.method == "sdkman":
            ctx.sh('rm -rf "$HOME/.sdkman"')
            ctx.rc.remove("sdkman")
        elif det.method == "mise":
            mise_remove(ctx, "java")
        elif det.method == "apt":
            ctx.apt.purge("openjdk-*-jdk", "openjdk-*-jre", "default-jdk", "default-jre")
        else:
            ctx.apt.purge("temurin-*")
            ctx.apt.remove_repo("adoptium")
        ctx.state.drop(self.id)


